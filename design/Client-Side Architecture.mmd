classDiagram
    namespace Frontend_GUI {
        class MainWindowQt {
            +controller: AppController
            +email_list: QListWidget
            +display_emails(emails)
            +display_email_content(html)
            +open_compose_window()
            +logout()
            +_on_refresh()
            +_on_reply()
            +_on_delete()
        }
        
        class ComposeDialog {
            +result_data: Dict
            +_on_accept()
            +get_data()
        }

        class AuthViews {
            <<LoginDialog / SignupDialog>>
            +get_data()
        }
    }

    namespace Logic_Layer {
        class AppController {
            +view: ViewInterface
            +storage: StorageWrapper
            +smtp: SMTPWrapper
            +pop3: POP3Wrapper
            +user: str
            +__init__(view, username, password)
            +load_user_emails(user)
            +compose_email(initial_data)
            +send_email(email_data)
            +delete_email(index)
            +reply_to_email(index)
            +refresh_emails()
            +logout()
        }

        class AuthController {
            +user_manager: UserManager
            +login(username, password)
            +signup(username, password)
        }

        class AutologinManager {
            <<Module>>
            +get_saved_credentials()
            +save_credentials(user, pass)
            +delete_credentials()
        }
    }

    namespace Wrappers {
        class SMTPWrapper {
            +send_email(sender, recipients, subject, body)
        }
        
        class POP3Wrapper {
            +fetch_new_emails(user, pass)
        }
        
        class StorageWrapper {
            +storage_manager: StorageManager
            +list_emails(user)
            +save_email(user, content)
            +delete_email(user, uid)
        }
    }

    namespace Protocol_Clients {
        class SMTPClient {
            +sock: socket
            +dispatcher: RDTDispatcher
            +rdt_sender: RDTSender
            +send_email(sender, recipient, subject, body)
            +_connect()
            +_do_handshake()
            +_send_mail_from()
            +_send_rcpt_to()
            +_send_data()
            +_send_quit()
        }

        class POP3Client {
            +sock: socket
            +dispatcher: RDTDispatcher
            +rdt_sender: RDTSender
            +connect()
            +authenticate(user, pass)
            +stat()
            +list()
            +retr(msg_num)
            +dele(msg_num)
            +quit()
            +get_all_messages(user, pass)
        }
    }

    MainWindowQt --|> ViewInterface : implements
    MainWindowQt --> AppController : delegates logic
    AppController --> SMTPWrapper : uses
    AppController --> POP3Wrapper : uses
    AppController --> StorageWrapper : uses
    SMTPWrapper ..> SMTPClient : instantiates
    POP3Wrapper ..> POP3Client : instantiates
    SMTPClient --> RDTDispatcher : uses
    POP3Client --> RDTDispatcher : uses