classDiagram
    namespace ProtocolServers {
        class SMTPServer {
            +host: str
            +port: int
            +dispatcher: RDTDispatcher
            +rdt_receiver: RDTReceiver
            +storage: StorageManager
            +__init__(host, port)
            +start()
            +stop()
            +_serve_loop()
            +_handle_data_stream(addr, session, data)
            +_finalize_message(addr, session, msg_bytes)
            +_handle_command_stream(addr, session, data, sessions)
            +_cmd_HELO(addr, session, arg, sessions)
            +_cmd_MAIL(addr, session, arg, sessions)
            +_cmd_RCPT(addr, session, arg, sessions)
            +_cmd_DATA(addr, session, arg, sessions)
            +_cmd_QUIT(addr, session, arg, sessions)
        }

        class POP3Server {
            +host: str
            +port: int
            +dispatcher: RDTDispatcher
            +rdt_receiver: RDTReceiver
            +storage: StorageManager
            +user_manager: UserManager
            +__init__(host, port)
            +start()
            +stop()
            +_serve_loop()
            +_handle_command(addr, session, line, sessions)
            +_cmd_USER(addr, session, args)
            +_cmd_PASS(addr, session, args)
            +_cmd_STAT(addr, session, args)
            +_cmd_LIST(addr, session, args)
            +_cmd_RETR(addr, session, args)
            +_cmd_DELE(addr, session, args)
            +_cmd_QUIT(addr, session, args)
        }
    }

    namespace DataManagement {
        class StorageManager {
            <<Singleton>>
            +mailbox_reader: MailboxReader
            +mailbox_writer: MailboxWriter
            +locks: Dict
            +get_lock(username)
            +save_email(user, email_data)
            +list_messages(user)
            +get_message_content(user, filename)
            +delete_email(user, filename)
        }

        class MailboxWriter {
            +write_email(user, email_data)
            +mark_message_as_deleted(user, filename)
            +_save_metadata(path, data)
        }

        class MailboxReader {
            +list_messages(user)
            +read_message(user, filename)
            +get_uid(user, filename)
            +_load_metadata(path)
        }

        class UserManager {
            <<Singleton>>
            +users: Dict
            +db_file: str
            +get_user(username)
            +create_user(username, password)
            +authenticate(username, password)
            +_load_users()
            +_save_users()
        }

        class User {
            +username: str
            +password: str
            +mailbox_path: str
            +set_password(raw)
            +verify_password(raw)
            +to_dict()
        }
    }

    SMTPServer --> StorageManager : saves mail
    SMTPServer --> RDTDispatcher : uses
    POP3Server --> StorageManager : retrieves/deletes mail
    POP3Server --> UserManager : authenticates
    POP3Server --> RDTDispatcher : uses
    StorageManager *-- MailboxReader
    StorageManager *-- MailboxWriter
    UserManager *-- User : manages