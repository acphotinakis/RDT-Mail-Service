sequenceDiagram
    participant User
    participant GUI as MainWindowQt
    participant Ctrl as AppController
    participant Wrap as SMTPWrapper
    participant Client as SMTPClient
    participant RDT as RDT_Layer
    participant Server as SMTPServer
    participant Storage as StorageManager

    User->>GUI: Click Send
    GUI->>Ctrl: send_email(data)
    Ctrl->>Wrap: send_email(sender, recipients...)
    
    loop For Each Recipient
        Wrap->>Client: new SMTPClient()
        Wrap->>Client: send_email(...)
        
        Client->>RDT: Connect (Handshake)
        RDT->>Server: (Packet Transmission)
        Server-->>Client: 220 Ready
        
        Client->>RDT: HELO
        RDT->>Server: (Packet)
        Server-->>Client: 250 OK
        
        Client->>RDT: MAIL FROM / RCPT TO
        RDT->>Server: (Packet)
        Server-->>Client: 250 OK
        
        Client->>RDT: DATA
        RDT->>Server: (Packet)
        Server-->>Client: 354 Start Input
        
        Client->>RDT: <Email Body>
        RDT->>Server: (Packet Stream)
        
        Server->>Storage: save_email(user, data)
        Storage-->>Server: success
        Server-->>Client: 250 OK
        
        Client->>RDT: QUIT
        RDT->>Server: (Packet)
        Server-->>Client: 221 Bye
        
        Client->>RDT: Close Socket
    end
    
    Wrap-->>Ctrl: Success
    Ctrl-->>GUI: Show "Email Sent"